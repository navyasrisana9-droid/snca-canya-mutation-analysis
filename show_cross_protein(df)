import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import streamlit as st
from pathlib import Path

SHORT = {"alpha-synuclein": "α-synuclein", "amyloid-beta 42": "Aβ42",
         "tau repeat domain": "Tau (RD)"}
COLORS = ["#7c3aed", "#ec4899", "#0ea5e9"]
INK = "#222222"


def _style(ax, title, ylabel):
    ax.set_facecolor("white")
    ax.set_title(title, fontsize=11, fontweight="bold", color=INK, loc="left")
    ax.set_ylabel(ylabel, color=INK, fontsize=9)
    ax.tick_params(colors=INK, labelsize=9)
    for s in ("top", "right"):
        ax.spines[s].set_visible(False)
    for s in ("left", "bottom"):
        ax.spines[s].set_color("#999999")


def show_cross_protein(df):
    d = df.copy()
    d["label"] = d["protein"].map(SHORT).fillna(d["protein"])

    # 1. Readable table
    table = d[["label", "n_mutations", "mean_abs_delta", "fraction_increasing",
               "spearman_delta_vs_hydrophobicity_change",
               "mean_delta_to_proline", "mean_delta_to_charged_DEKR"]].rename(columns={
        "label": "Protein", "n_mutations": "Mutations",
        "mean_abs_delta": "Mean |Δ|",
        "fraction_increasing": "Share raising score",
        "spearman_delta_vs_hydrophobicity_change": "Δ vs hydrophobicity (ρ)",
        "mean_delta_to_proline": "Mean Δ, proline",
        "mean_delta_to_charged_DEKR": "Mean Δ, D/E/K/R"})
    st.dataframe(table.round(3), use_container_width=True, hide_index=True)

    # 2. Three panels that carry the findings
    fig, axes = plt.subplots(1, 3, figsize=(12, 3.8), facecolor="white")
    x = np.arange(len(d))

    ax = axes[0]
    bars = ax.bar(x, d["fraction_increasing"], color=COLORS[:len(d)])
    ax.axhline(0.5, color="#999999", ls="--", lw=1)
    ax.set_ylim(0, 1)
    ax.set_xticks(x); ax.set_xticklabels(d["label"])
    ax.bar_label(bars, fmt="%.2f", padding=3, color=INK, fontsize=9)
    _style(ax, "Share of mutations raising the score", "Fraction")

    ax = axes[1]
    bars = ax.bar(x, d["spearman_delta_vs_hydrophobicity_change"], color=COLORS[:len(d)])
    ax.set_ylim(0, 0.7)
    ax.set_xticks(x); ax.set_xticklabels(d["label"])
    ax.bar_label(bars, fmt="%.2f", padding=3, color=INK, fontsize=9)
    _style(ax, "More hydrophobic → higher score", "Spearman ρ")

    ax = axes[2]
    w = 0.38
    b1 = ax.bar(x - w / 2, d["mean_delta_to_proline"], w, label="Proline", color="#f59e0b")
    b2 = ax.bar(x + w / 2, d["mean_delta_to_charged_DEKR"], w, label="D/E/K/R", color="#14b8a6")
    ax.axhline(0, color="#666666", lw=1)
    ax.set_xticks(x); ax.set_xticklabels(d["label"])
    ax.bar_label(b1, fmt="%.3f", padding=3, color=INK, fontsize=8)
    ax.bar_label(b2, fmt="%.3f", padding=3, color=INK, fontsize=8)
    ax.legend(frameon=False, fontsize=8, labelcolor=INK)
    _style(ax, "Proline and charged residues lower it", "Mean Δ score")

    fig.tight_layout()
    st.pyplot(fig)

    # 3. Position profiles from the pipeline
    prof = Path("results/cross_protein_profiles.png")
    if prof.exists():
        st.image(str(prof), caption="Mean |Δ| by position, per protein. "
                 "Tau positions are numbered within the repeat domain (residues 244-372).",
                 use_container_width=True)

    st.markdown(
        "**What this shows.** In all three proteins, mutations that make a residue "
        "more hydrophobic tend to raise the predicted nucleation score, and proline "
        "and charged substitutions tend to lower it. The share of mutations that "
        "raise the score differs between proteins.\n\n"
        "**Caveats.** These are CANYA predictions on 20-residue windows, not "
        "experimental measurements. Shared sequence-level features do not establish "
        "a shared mechanism. Huntingtin and TDP-43 have not been analyzed."
    )